POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=pipeline
FRONTEND_PORT=8080
# 1 — фейковые этапы для проверки платформы без модели и продукта
PIPELINE_FAKE_STAGES=0
# Модель: любой OpenAI-совместимый endpoint (harness/llm_config.py)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
# Провайдер OpenRouter без подмены; пусто — не закреплять. Для других endpoint не используется.
LLM_PROVIDER=Near AI
# Parallel tasks per worker: several runs move at once; LLM_MAX_PARALLEL still caps requests to the provider.
LLM_WORKER_CONCURRENCY=5
BUILD_WORKER_CONCURRENCY=4
# Shared limits across workers on one VPS. Zero disables the respective limit.
LLM_TPM_LIMIT=0
LLM_RPM_LIMIT=0
LLM_MAX_PARALLEL=0
LLM_RATE_WINDOW_SECONDS=60
LLM_RATE_SAFETY_TOKENS=512
LLM_RATE_INPUT_BYTES_PER_TOKEN=3
LLM_RATE_MAX_WAIT_SECONDS=60
LLM_DEFAULT_MAX_TOKENS=4096
# Путь к tokenizer.json внутри контейнера при наличии файла
# LLM_TOKENIZER_PATH=/app/tokenizer.json

# Langfuse: трассы прогонов (docker compose --profile langfuse up -d, UI http://localhost:3000).
# Пустые ключи — ничего не отправляется. Ключи и первый пользователь создаются при первом старте Langfuse.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Для общего сервера: openssl rand -hex 32
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_SALT=
# LANGFUSE_NEXTAUTH_SECRET=
