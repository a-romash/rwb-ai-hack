{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "pipeline-manager": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/pipeline-manager",
            "browser": "src/main.ts",
            "index": "src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.less"],
            "assets": [{"glob": "**/*", "input": "node_modules/@taiga-ui/icons/src", "output": "assets/taiga-ui/icons"}]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{"type": "initial", "maximumWarning": "1MB", "maximumError": "2MB"}]
            },
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {"development": {"buildTarget": "pipeline-manager:build:development"}},
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {"analytics": false}
}
