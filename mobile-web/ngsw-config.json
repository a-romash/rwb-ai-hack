{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {"files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]}
    }
  ],
  "dataGroups": [
    {
      "name": "api",
      "urls": ["api/**"],
      "cacheConfig": {"strategy": "freshness", "maxSize": 200, "maxAge": "1d", "timeout": "5s"}
    }
  ]
}
